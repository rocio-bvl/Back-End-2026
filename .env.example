# Copiar este archivo como .env y completar los valores.
# Las comillas simples evitan problemas con caracteres como $ en las claves.
SECRET_KEY='escribe-aqui-una-clave-larga-y-aleatoria'
DEBUG=True
# En EC2 agrega la IP pública: 127.0.0.1,localhost,54.123.45.67
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.mysql
DB_NAME=municipalidad
DB_USER=admin_muni
DB_PASSWORD='tu_clave'
DB_HOST=localhost
DB_PORT=3306

# Correo para recuperar contraseña (Gmail: contraseña de aplicación, no la clave normal).
# Si EMAIL_HOST_USER queda vacío, el correo se muestra en la terminal en vez de enviarse.
EMAIL_HOST_USER=sgr.laserena@gmail.com
EMAIL_HOST_PASSWORD='xxxxxxxxx'
DEFAULT_FROM_EMAIL='Recuperar Contraseña- SGR Municipalidad de La Serena <sgr.laserena@gmail.com>'
EMAIL_PORT=

# Segundo factor: código por correo al iniciar sesión. Activar (True) solo cuando los usuarios tengan correos
# reales y el correo de arriba funcione: si no, nadie recibe el código y nadie puede entrar.
MFA_ACTIVO=False

# HTTPS: poner True SOLO cuando el servidor ya tenga certificado (Nginx + Certbot). Con True y sin HTTPS,
# nadie puede iniciar sesión. CSRF_TRUSTED_ORIGINS lleva el dominio con https://
USAR_HTTPS=False
HSTS_SEGUNDOS=3600
CSRF_TRUSTED_ORIGINS=

# Respaldos (python manage.py respaldar_bd). En WAMP, MYSQLDUMP es la ruta completa, por ejemplo
# C:\wamp64\bin\mysql\mysql8.3.0\bin\mysqldump.exe
RESPALDO_DIR=
RESPALDO_CANTIDAD=14
MYSQLDUMP=mysqldump

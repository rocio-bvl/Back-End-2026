# Copiar este archivo como .env y completar los valores.
# Las comillas simples evitan problemas con caracteres como $ en las claves.
SECRET_KEY='escribe-aqui-una-clave-larga-y-aleatoria'
DEBUG=True
# En EC2 agrega la IP pública: 127.0.0.1,localhost,54.123.45.67
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.mysql
DB_NAME=municipalidad
DB_USER=admin_muni
DB_PASSWORD='tu_clave'
DB_HOST=localhost
DB_PORT=3306

# Correo para recuperar contraseña (Gmail: contraseña de aplicación, no la clave normal).
# Si EMAIL_HOST_USER queda vacío, el correo se muestra en la terminal en vez de enviarse.
EMAIL_HOST_USER=sgr.laserena@gmail.com
EMAIL_HOST_PASSWORD='xxxxxxxxx'
DEFAULT_FROM_EMAIL='Recuperar Contraseña- SGR Municipalidad de La Serena <sgr.laserena@gmail.com>'
EMAIL_PORT=465

# Chatbot con IA (API compatible con OpenAI Chat Completions). La clave se usa SOLO en el servidor
# y nunca llega al navegador. Si no hay API configurada ni modelo local, el chatbot queda desactivado.
# OpenAI:     https://api.openai.com/v1/chat/completions       (ej. gpt-4o-mini)
# OpenRouter: https://openrouter.ai/api/v1/chat/completions    (ej. openai/gpt-4o-mini)
# Groq:       https://api.groq.com/openai/v1/chat/completions  (ej. llama-3.3-70b-versatile)
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/chat/completions (ej. gemini-2.0-flash)
CHATBOT_API_KEY=''
CHATBOT_API_URL='https://api.openai.com/v1/chat/completions'
CHATBOT_MODEL='gpt-4o-mini'
CHATBOT_TIMEOUT=30

# Alternativa local (Ollama): si CHATBOT_MODEL queda vacío se usa este modelo, sin clave ni
# internet. Requiere `ollama serve` y el modelo descargado (`ollama pull <modelo>`).
CHATBOT_LOCAL_API_URL='http://127.0.0.1:11434/v1/chat/completions'
CHATBOT_LOCAL_MODEL=''
CHATBOT_LOCAL_TIMEOUT=120
# Modelos de razonamiento (p. ej. qwen): 'none' hace que la respuesta llegue en 'content'.
CHATBOT_LOCAL_REASONING_EFFORT='none'

# Fase 2: RAG, caché por usuario y observabilidad (segundos y caracteres).
CHATBOT_PROMPT_VERSION=2.1
# Guardrail de entrada: completo (multicapa) o basico (9 patrones históricos, rollback).
CHATBOT_GUARDRAIL_MODO=completo
CHATBOT_CACHE_TTL=600
# Mensajes recientes del historial que forman parte de la clave de caché (4 = dos turnos).
# Incluirlos evita reutilizar respuestas de otra conversación e invalida al usar "Nueva", a costa
# de una tasa de acierto menor (cada turno cambia la huella). 0 desactiva el historial en la clave.
CHATBOT_CACHE_HISTORIAL_MENSAJES=4
CHATBOT_RATE_LIMIT=30
CHATBOT_RATE_VENTANA=3600
# Backend del rate limit: 'db' lo comparte entre todos los procesos (recomendado en producción);
# 'cache' usa LocMemCache por proceso (solo desarrollo/rollback). El system check advierte si es
# 'cache' con DEBUG=False.
CHATBOT_RATE_BACKEND=db
CHATBOT_RAG_MAX_CARACTERES=4000
CHATBOT_MAX_RESPUESTA=4000
# Canarios sintéticos (separados por comas) que el saneo de salida redacta siempre. Vacío por defecto.
CHATBOT_CANARIOS=''
# Historial enviado al proveedor: tope por mensaje y presupuesto total en caracteres.
CHATBOT_MAX_HISTORIAL_MENSAJE=1000
CHATBOT_MAX_HISTORIAL_CARACTERES=4000
# Techo duro del prompt completo (sistema + contexto + historial + pregunta); la pregunta nunca se recorta.
CHATBOT_MAX_PROMPT_CARACTERES=20000
# Retención (T-C-04): días que se conservan los mensajes y los eventos, y tope de mensajes por
# usuario. La purga se ejecuta con `python manage.py purgar_chatbot`; programarla (cron/systemd
# timer) es decisión de Operaciones y no se activa desde el código.
CHATBOT_RETENCION_MENSAJES_DIAS=90
CHATBOT_RETENCION_EVENTOS_DIAS=365
CHATBOT_MAX_MENSAJES_POR_USUARIO=200
CHATBOT_LOG_LEVEL=INFO

# Copiar este archivo como .env y completar los valores.
# Las comillas simples evitan problemas con caracteres como $ en las claves.
SECRET_KEY='escribe-aqui-una-clave-larga-y-aleatoria'
DEBUG=True
# En EC2 agrega la IP pública: 127.0.0.1,localhost,54.123.45.67
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.mysql
DB_NAME=municipalidad
DB_USER=admin_muni
DB_PASSWORD='tu_clave'
DB_HOST=localhost
DB_PORT=3306

# Correo para recuperar contraseña (Gmail: contraseña de aplicación, no la clave normal).
# Si EMAIL_HOST_USER queda vacío, el correo se muestra en la terminal en vez de enviarse.
EMAIL_HOST_USER=sgr.laserena@gmail.com
EMAIL_HOST_PASSWORD='xxxxxxxxx'
DEFAULT_FROM_EMAIL='Recuperar Contraseña- SGR Municipalidad de La Serena <sgr.laserena@gmail.com>'
EMAIL_PORT=465

# Chatbot con IA (API compatible con OpenAI Chat Completions). La clave se usa SOLO en el servidor
# y nunca llega al navegador. Si CHATBOT_API_KEY queda vacía, el chatbot queda desactivado.
# OpenAI:     https://api.openai.com/v1/chat/completions       (ej. gpt-4o-mini)
# OpenRouter: https://openrouter.ai/api/v1/chat/completions    (ej. openai/gpt-4o-mini)
# Groq:       https://api.groq.com/openai/v1/chat/completions  (ej. llama-3.3-70b-versatile)
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/chat/completions (ej. gemini-2.0-flash)
# Ollama:     http://127.0.0.1:11434/v1/chat/completions    (ej. qwen3.5_progra_128k:latest)
#   Ollama permite usar un modelo local (sin costo ni clave real). La clave se ignora, pero
#   CHATBOT_API_KEY debe tener algún valor (ej. 'ollama') para que el chatbot quede activo.
CHATBOT_API_KEY=''
CHATBOT_API_URL='https://api.openai.com/v1/chat/completions'
CHATBOT_MODEL='gpt-4o-mini'
CHATBOT_TIMEOUT=30

# Alternativa local (Ollama): si CHATBOT_MODEL queda vacío se usa este modelo, sin clave y sin
# internet. Requiere `ollama serve` y el modelo descargado (`ollama pull <modelo>`).
CHATBOT_LOCAL_API_URL='http://127.0.0.1:11434/v1/chat/completions'
CHATBOT_LOCAL_MODEL=''
CHATBOT_LOCAL_TIMEOUT=120
# Modelos de razonamiento (p. ej. qwen): 'none' hace que la respuesta llegue en 'content'.
CHATBOT_LOCAL_REASONING_EFFORT='none'
